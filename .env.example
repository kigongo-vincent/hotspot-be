APP_PORT=3001

ALLOWED_ORIGINS=http://localhost:5173
# Public web app URL (used in lab invite emails). Falls back to FRONTEND_URL or localhost:5173.
APP_PUBLIC_URL=http://localhost:5173
JWT_SECRET=replace-with-strong-random-secret

GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your-google-calendar-refresh-token
GOOGLE_CALENDAR_ID=primary

AWS_REGION=eu-north-1
AWS_BUCKET=your-s3-bucket-name
AWS_S3_ACCESS=your-aws-access-key-id
AWS_S3_SECRET=your-aws-secret-access-key
#
# Amazon SES — required for lab invite emails and other outbound mail (same AWS account/region as above is typical).
# Verified identity: AWS_SES_FROM must be an address or domain verified in SES (SES v2 SendEmail).
# IAM for AWS_SES_ACCESS / AWS_SES_SECRET needs ses:SendEmail (and identity must be out of sandbox in production).
AWS_SES_FROM=noreply@your-verified-domain.example.com
AWS_SES_ACCESS=
AWS_SES_SECRET=
# If AWS_SES_ACCESS / AWS_SES_SECRET are empty, the app falls back to AWS_S3_ACCESS / AWS_S3_SECRET (that user must also be allowed to send via SES).
#
# Optional: if using CloudFront/custom domain for uploaded assets (served URLs, not the API proxy below)
AWS_PUBLIC_BASE_URL=https://your-cdn-or-public-assets-domain
# Base URL of this API’s /api/v1 prefix, no trailing slash. When set, uploaded files’ publicUrl points at
# GET /api/v1/storage/objects/<key> which streams from S3 with IAM (private bucket, no S3 public read policy).
# Local: http://localhost:3001/api/v1   Production: https://your-api-host/api/v1 (must be reachable from the browser)
STORAGE_PUBLIC_PROXY_BASE=http://localhost:3001/api/v1
#
# Browser uploads (presigned PUT from the SPA) require S3 bucket CORS on AWS:
# S3 → bucket → Permissions → Cross-origin resource sharing (CORS), e.g.
# [
#   { "AllowedOrigins": ["http://localhost:5173","https://your-production-origin"],
#     "AllowedMethods": ["GET","PUT","POST","HEAD"],
#     "AllowedHeaders": ["*"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3000 }
# ]
# Without this, the browser shows: preflight has no Access-Control-Allow-Origin → net::ERR_FAILED.
# CORS is per-origin: the same bucket can work for https://app.example.com but still block http://localhost:5173
# until that exact origin is listed in AllowedOrigins (or you use a wildcard origin in dev — not recommended for prod).
#
# If presigned PUT returns 403, open DevTools → Network → failed PUT → Response (S3 XML).
#
# AccessDenied (most common): CORS and "no bucket policy" do NOT grant writes. The IAM *user*
# whose access key matches AWS_S3_ACCESS must have an IAM policy allowing PutObject on the keys
# this app uses (object keys look like uploads/<uuid>/<uuid>-<filename>).
#
# Attach an inline policy (or add to a group) on that IAM user — IAM → Users → <user> → Add permissions →
# Create inline policy → JSON, e.g. (replace YOUR_BUCKET with AWS_BUCKET, e.g. ensigo):
#
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Sid": "AppUploadsReadWrite",
#       "Effect": "Allow",
#       "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
#       "Resource": "arn:aws:s3:::YOUR_BUCKET/uploads/*"
#     }
#   ]
# }
#
# If the bucket default encryption is SSE-KMS (not SSE-S3), add KMS permissions on that CMK for the same user:
# kms:Encrypt, kms:Decrypt, kms:GenerateDataKey (see the key’s ARN in S3 → bucket → Properties → Default encryption).
#
# SignatureDoesNotMatch: presigned URL must be used immediately; body byte length must match contentLength
# sent when requesting the presigned URL; do not add extra headers beyond what the browser sends for a raw PUT.
#
# --- Viewing uploads (GET) ---
# Prefer STORAGE_PUBLIC_PROXY_BASE (see above) so the API streams objects; IAM user still needs s3:GetObject.
# Alternatively: S3 bucket policy with Principal "*" and s3:GetObject on arn:aws:s3:::YOUR_BUCKET/uploads/*,
# or CloudFront + OAC and set AWS_PUBLIC_BASE_URL to the distribution.

AWS_SES_ACCESS=
AWS_SES_SECRET=
AWS_SES_FROM=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSLMODE=disable
